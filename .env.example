# Copy to .env (never committed). Only the provider the harness is configured for is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Which remote API the frozen harness model is called through (set in Phase 1).
HARNESS_PROVIDER=anthropic
HARNESS_MODEL=claude-haiku-5-5
# Optional overrides
HARNESS_MAX_CONCURRENCY=8
